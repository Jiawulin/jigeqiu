{
  "name": "jigeqiu-web",
  "private": true,
  "version": "0.1.6",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build",
    "build:extension": "node extension/scripts/build.mjs",
    "build:extension:migrate": "node extension/scripts/build.mjs --legacy-id",
    "package:extension": "node extension/scripts/package.mjs",
    "test:extension": "node --import tsx --test extension/tests/*.test.mjs",
    "test:browser:extension": "npm run build:extension && node extension/tests/browser.mjs && node extension/tests/browser-i18n.mjs && node extension/tests/browser-capture.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check package.json eslint.config.mjs .prettierrc.json \".github/workflows/*.yml\" \"tests/tooling/*.mjs\"",
    "format": "prettier --write package.json eslint.config.mjs .prettierrc.json \".github/workflows/*.yml\" \"tests/tooling/*.mjs\"",
    "test:tooling": "node --test tests/tooling/*.test.mjs",
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "test:unit": "node scripts/test-selected.mjs unit",
    "test:browser": "node scripts/test-selected.mjs browser",
    "test:legacy": "node --import tsx --test tests/legacy/*.test.ts",
    "test:contracts": "node tests/contracts/typecheck.mjs",
    "test:browser:persistence": "node tests/browser/persistence.mjs",
    "test:browser:chrome-import": "node tests/browser/chrome-import.mjs",
    "test:browser:desktop-import": "node tests/browser/desktop-import.mjs",
    "test:browser:manual-bookmark": "node tests/browser/manual-bookmark.mjs",
    "test:browser:desktop-ui": "node tests/browser/desktop-ui.mjs",
    "test:browser:desktop-keyboard": "node tests/browser/desktop-keyboard.mjs",
    "test:browser:desktop-first-use": "node tests/browser/desktop-first-use.mjs",
    "test:browser:desktop-touch": "node tests/browser/desktop-touch.mjs",
    "test:browser:desktop-mouse": "node tests/browser/desktop-mouse.mjs",
    "test:browser:desktop-folders": "node tests/browser/desktop-folders.mjs",
    "test:browser:launchpad": "node tests/browser/launchpad.mjs",
    "test:browser:launchpad-gestures": "node tests/browser/launchpad-gestures.mjs",
    "test:browser:launchpad-inertia": "node tests/browser/launchpad-inertia.mjs",
    "test:browser:launchpad-scroll-ownership": "node tests/browser/launchpad-scroll-ownership.mjs",
    "test:browser:launchpad-first-open": "npm run build && node tests/browser/launchpad-first-open.mjs",
    "test:browser:appearance": "node tests/browser/desktop-appearance.mjs",
    "test:browser:wallpaper-cache": "node tests/browser/wallpaper-cache.mjs",
    "test:browser:custom-wallpaper": "node tests/browser/custom-wallpaper.mjs",
    "test:browser:wallpaper-framing": "node tests/browser/wallpaper-framing.mjs",
    "test:browser:trash-pagination": "node tests/browser/trash-pagination.mjs",
    "test:browser:bookmark-select": "node tests/browser/bookmark-select.mjs",
    "test:browser:site-icons": "node tests/browser/site-icons.mjs",
    "test:browser:icon-picker": "node tests/browser/icon-picker.mjs",
    "test:browser:bookmark-form": "node tests/browser/bookmark-form.mjs",
    "test:browser:spotlight-ui": "node tests/browser/spotlight-ui.mjs",
    "test:browser:spotlight-commands": "node tests/browser/spotlight-commands.mjs",
    "test:browser:spotlight-library": "node tests/browser/spotlight-library.mjs",
    "test:browser:bookmark-search": "node tests/browser/bookmark-search.mjs",
    "test:browser:navigation": "node tests/browser/navigation.mjs",
    "test:browser:management-scroll": "node tests/browser/management-scroll.mjs",
    "test:browser:hash-routing": "node tests/browser/hash-routing.mjs",
    "test:browser:json-assets": "node tests/browser/json-assets.mjs",
    "test:browser:workbench-backup": "node tests/browser/workbench-backup.mjs",
    "test:browser:transfer-formats": "node tests/browser/transfer-formats.mjs",
    "test:browser:static-first-use": "npm run build && node tests/browser/static-first-use.mjs",
    "test:browser:capacity": "npm run build && node tests/browser/capacity.mjs",
    "test:browser:data-correctness": "node tests/browser/data-correctness.mjs",
    "test:browser:library-i18n": "node tests/browser/library-i18n.mjs",
    "test:browser:mutation-entrypoints": "node tests/browser/mutation-entrypoints.mjs",
    "test:browser:collections": "node tests/browser/collections.mjs",
    "test:browser:onboarding": "node tests/browser/onboarding.mjs",
    "check": "npm run test && npm run test:extension && npm run test:tooling && npm run test:contracts && npm run lint && npm run typecheck && npm run format:check && npm run build"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "driver.js": "1.10.2",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "parse5": "8.0.1",
    "pinyin-pro": "3.29.5",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "eslint": "10.13.0",
    "fflate": "0.8.2",
    "globals": "16.5.0",
    "prettier": "3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
